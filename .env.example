# --- Required ---
# PostgreSQL connection string (Vercel: add Neon/Postgres from the Marketplace; it sets this for you)
DATABASE_URL="postgresql://user:pass@host:5432/spadesk?sslmode=require"
# Long random strings. Generate with: openssl rand -base64 48
AUTH_SECRET=""
ENCRYPTION_KEY=""
CRON_SECRET=""

# --- Recommended ---
# Your public URL, e.g. https://spadesk.co.ke (on Vercel it falls back to the project's production URL)
APP_URL=""
# One-time token for /admin/setup?token=... to create the first platform admin on a hosted deploy
ADMIN_SETUP_TOKEN=""

# --- Optional: messaging defaults (can also be set in Admin → API keys) ---
MESSAGE_PROVIDER="console"
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
