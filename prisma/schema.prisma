generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A Business is a tenant: one salon/spa account. Every record below is scoped to one.
model Business {
  id                   String         @id @default(cuid())
  name                 String
  slug                 String         @unique // public booking link: /book/<slug>
  phone                String?
  email                String?
  address              String?
  currency             String         @default("KES")
  timezone             String         @default("Africa/Nairobi")
  countryCode          String         @default("254") // used to normalise local phone numbers
  openTime             String         @default("08:00")
  closeTime            String         @default("19:00")
  openDays             Int[]          @default([1, 2, 3, 4, 5, 6]) // ISO weekdays, 1 = Monday
  slotMinutes          Int            @default(15)
  reminderHours        Int            @default(24)
  bookingEnabled       Boolean        @default(true)
  messageChannel       Channel        @default(SMS)
  // Subscription / trial
  status               BusinessStatus @default(TRIAL)
  trialEndsAt          DateTime
  paidUntil            DateTime?
  plan                 String         @default("standard")
  adminNotes           String?
  // Booking policies
  depositPercent       Int            @default(0) // 0 = no deposit asked
  cancelPolicyHours    Int            @default(24) // client self-cancel allowed until N hours before
  cancelPolicyText     String?
  bufferMinutes        Int            @default(0) // clean-up time after each appointment
  mpesaType            String? // TILL | PAYBILL | POCHI | PHONE
  mpesaNumber          String?
  mpesaAccount         String? // paybill account number
  onboardingDone       Boolean        @default(false)
  // Payments & M-Pesa verification
  paymentMethods       String[]       @default(["CASH", "MPESA", "CARD"])
  requireVerifiedMpesa Boolean        @default(false) // only accept codes Safaricom has confirmed (C2B)
  darajaShortcode      String?
  darajaKeyEnc         String? // encrypted consumer key
  darajaSecretEnc      String? // encrypted consumer secret
  darajaEnv            String         @default("production")
  c2bToken             String         @unique @default(cuid()) // secret part of the callback URL
  c2bRegisteredAt      DateTime?
  // Founding offer: first N paying salons get a discount for M months
  foundingMember       Boolean        @default(false)
  discountPercent      Int            @default(0)
  discountUntil        DateTime?
  payrollConfig        Json? // statutory deduction rules, see src/lib/payroll.ts
  // Location: typed at sign-up (country/region/city + address), with coordinates for the admin map
  country              String? // ISO 3166-1 alpha-2, e.g. "KE"
  region               String? // county / state
  city                 String? // town or neighbourhood
  latitude             Float?
  longitude            Float?
  locationSource       String? // "county" (typed county centre) | "ip" (network location at sign-up)
  signupGeo            Json? // network location seen at sign-up: { country, region, city, latitude, longitude }
  isShowcase           Boolean        @default(false) // admin-created salon used only to film reels; excluded from stats and maps
  // Brand and homepage features
  logoId               String? // Media id of the salon's uploaded logo
  featureConsent       Boolean        @default(false) // salon allows Darling to show its logo and service photos on darling's website
  homeLogo             Boolean        @default(false) // admin: show this salon's logo in "Salons on Darling"
  homeServices         Boolean        @default(false) // admin: show this salon's service photos in the homepage carousel
  createdAt            DateTime       @default(now())

  users         User[]
  clients       Client[]
  services      Service[]
  appointments  Appointment[]
  sales         Sale[]
  messages      MessageLog[]
  mpesaTxns     MpesaTransaction[]
  payRuns       PayRun[]
  advances      StaffAdvance[]
  notifications Notification[]
  media         Media[]
  complaints    Complaint[]
}

enum BusinessStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

// Staff members. Anyone who can be booked or can log in.
model User {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  email          String    @unique
  phone          String?
  passwordHash   String
  role           Role      @default(STAFF)
  title          String? // e.g. "Senior stylist"
  bookable       Boolean   @default(true)
  commissionRate Decimal   @default(0) @db.Decimal(5, 2) // percent of service revenue
  color          String    @default("#c084fc")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  // Payroll
  payType        PayType   @default(COMMISSION)
  baseSalary     Decimal   @default(0) @db.Decimal(12, 2) // per month
  chairRent      Decimal   @default(0) @db.Decimal(12, 2) // per pay run, chair-rental stylists pay the salon
  payoutPhone    String? // M-Pesa number for pay
  statutory      Boolean   @default(false) // apply PAYE/SHIF/NSSF/levy rules (employees, not casual/commission-only)
  tourDoneAt     DateTime? // product tour finished or skipped

  appointments Appointment[]
  saleItems    SaleItem[]
  payslips     Payslip[]
  advances     StaffAdvance[]
  services     Service[]      @relation("StaffServices") // empty = can perform every service

  notifyMuted   String[]           @default([]) // notification kinds this person turned off
  notifications Notification[]
  pushSubs      PushSubscription[]

  @@index([businessId])
}

model Client {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  phone       String // normalised, e.g. 254712345678
  email       String?
  birthday    DateTime? @db.Date
  allergies   String?
  preferences String?
  notes       String?
  marketingOk Boolean   @default(true)
  createdAt   DateTime  @default(now())

  appointments Appointment[]
  sales        Sale[]

  @@unique([businessId, phone])
  @@index([businessId, name])
}

model Service {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  category      String   @default("General")
  description   String?
  durationMin   Int
  price         Decimal  @db.Decimal(10, 2)
  active        Boolean  @default(true)
  onlineBooking Boolean  @default(true)
  createdAt     DateTime @default(now())

  appointments Appointment[]
  saleItems    SaleItem[]
  staff        User[]        @relation("StaffServices")

  styles ServiceStyle[]
  media  Media[]

  @@index([businessId])
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  WALK_IN
  PHONE
  ONLINE
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TIKTOK
  OTHER
}

model Appointment {
  id              String            @id @default(cuid())
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staffId         String?
  staff           User?             @relation(fields: [staffId], references: [id], onDelete: SetNull)
  serviceId       String
  service         Service           @relation(fields: [serviceId], references: [id])
  startAt         DateTime
  endAt           DateTime
  status          AppointmentStatus @default(BOOKED)
  source          BookingSource     @default(WALK_IN)
  price           Decimal           @db.Decimal(10, 2) // price at time of booking
  notes           String?
  styleId         String?
  styleName       String? // the style chosen, kept even if the style is later renamed or removed
  reminderSentAt  DateTime?
  depositAmount   Decimal           @default(0) @db.Decimal(10, 2)
  depositRef      String? // M-Pesa code supplied by client
  depositVerified Boolean           @default(false)
  manageToken     String            @unique @default(cuid()) // client self-service link
  cancelledBy     String? // CLIENT | STAFF
  createdAt       DateTime          @default(now())

  sale Sale?

  @@index([businessId, startAt])
  @@index([staffId, startAt])
  @@index([clientId])
}

enum PaymentMethod {
  SPLIT
  CASH
  MPESA
  CARD
  BANK
  OTHER
}

model Sale {
  id             String        @id @default(cuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  number         Int // receipt number, sequential per business
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  appointmentId  String?       @unique
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  subtotal       Decimal       @db.Decimal(10, 2)
  discount       Decimal       @default(0) @db.Decimal(10, 2)
  tip            Decimal       @default(0) @db.Decimal(10, 2)
  tipStaffId     String?
  depositApplied Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  reference      String? // M-Pesa code, card ref, etc.
  createdById    String?
  createdAt      DateTime      @default(now())

  items    SaleItem[]
  payments Payment[]

  @@unique([businessId, number])
  @@index([businessId, createdAt])
}

model SaleItem {
  id         String   @id @default(cuid())
  saleId     String
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  serviceId  String?
  service    Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  staffId    String?
  staff      User?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  name       String
  quantity   Int      @default(1)
  unitPrice  Decimal  @db.Decimal(10, 2)
  commission Decimal  @default(0) @db.Decimal(10, 2)
}

enum Channel {
  SMS
  WHATSAPP
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
}

model MessageLog {
  id            String        @id @default(cuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId      String?
  appointmentId String?
  channel       Channel
  to            String
  kind          String // CONFIRMATION, REMINDER, CANCELLATION, CUSTOM
  body          String
  status        MessageStatus @default(QUEUED)
  providerRef   String?
  error         String?
  createdAt     DateTime      @default(now())

  @@index([businessId, createdAt])
}

// ---------- Platform (super-admin) ----------

model PlatformAdmin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

// Key/value platform configuration: SEO defaults, trial length, signup switch, etc.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Third-party credentials managed from the admin panel. Values are AES-256-GCM encrypted.
model ApiCredential {
  id        String   @id @default(cuid())
  provider  String // africastalking | whatsapp | mpesa | smtp | custom
  name      String // e.g. AT_API_KEY
  label     String?
  encValue  String
  last4     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([provider, name])
}

// Per-route SEO overrides (title, description, OG image...)
model SeoPage {
  id          String   @id @default(cuid())
  path        String   @unique // "/", "/signup", "/pricing", "/book/*"
  title       String?
  description String?
  keywords    String?
  ogImage     String?
  noIndex     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String // admin email
  action     String
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// One row per tender on a sale: a sale can be part cash, part M-Pesa.
model Payment {
  id        String            @id @default(cuid())
  saleId    String
  sale      Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal           @db.Decimal(10, 2) // amount applied to the bill
  tendered  Decimal?          @db.Decimal(10, 2) // cash handed over (change = tendered - amount)
  reference String?
  payerName String?
  verified  Boolean           @default(false) // true when matched to a Safaricom-confirmed transaction
  mpesaTxId String?           @unique
  mpesaTx   MpesaTransaction? @relation(fields: [mpesaTxId], references: [id])
  createdAt DateTime          @default(now())
}

enum MpesaSource {
  C2B // pushed by Safaricom (verified)
  SMS // parsed from a pasted confirmation SMS (unverified)
  MANUAL // code typed without verification (unverified)
}

// Every M-Pesa payment the salon received or recorded. A code can be used once.
model MpesaTransaction {
  id            String      @id @default(cuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code          String // e.g. SKF3H7XQ2P
  amount        Decimal     @db.Decimal(10, 2)
  payerName     String?
  phone         String? // may be masked/hashed by Safaricom
  billRef       String?
  transTime     DateTime?
  source        MpesaSource
  raw           Json?
  usedFor       String? // SALE | DEPOSIT
  appointmentId String?
  claimedAt     DateTime?
  createdAt     DateTime    @default(now())

  payment Payment?

  @@unique([businessId, code])
  @@index([businessId, createdAt])
}

// ---------- Payroll ----------

enum PayType {
  COMMISSION
  SALARY
  BASE_PLUS_COMMISSION
  CHAIR_RENTAL
}

enum PayRunStatus {
  DRAFT
  APPROVED
  PAID
}

model PayRun {
  id          String       @id @default(cuid())
  businessId  String
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime // exclusive
  status      PayRunStatus @default(DRAFT)
  note        String?
  createdById String?
  approvedAt  DateTime?
  createdAt   DateTime     @default(now())

  payslips Payslip[]

  @@index([businessId, periodStart])
}

model Payslip {
  id              String         @id @default(cuid())
  payRunId        String
  payRun          PayRun         @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  payType         PayType
  base            Decimal        @default(0) @db.Decimal(12, 2)
  commission      Decimal        @default(0) @db.Decimal(12, 2)
  services        Int            @default(0)
  serviceRevenue  Decimal        @default(0) @db.Decimal(12, 2)
  tips            Decimal        @default(0) @db.Decimal(12, 2)
  bonus           Decimal        @default(0) @db.Decimal(12, 2)
  otherDeductions Decimal        @default(0) @db.Decimal(12, 2)
  advances        Decimal        @default(0) @db.Decimal(12, 2)
  statutory       Decimal        @default(0) @db.Decimal(12, 2)
  statutoryLines  Json?
  chairRent       Decimal        @default(0) @db.Decimal(12, 2)
  gross           Decimal        @default(0) @db.Decimal(12, 2)
  net             Decimal        @default(0) @db.Decimal(12, 2) // negative = stylist owes the salon (chair rent)
  note            String?
  paidAt          DateTime?
  paidMethod      PaymentMethod?
  paidRef         String?

  advanceItems StaffAdvance[]

  @@unique([payRunId, userId])
}

model StaffAdvance {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  date       DateTime
  note       String?
  payslipId  String? // set when recovered in a pay run
  payslip    Payslip? @relation(fields: [payslipId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([businessId, userId])
}

// Sign-up funnel: visits to /signup, submitted attempts and created accounts, with network location.
model SignupEvent {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  stage        String // "visit" | "attempt" | "created"
  visitorId    String // random id in a first-party cookie, to count unique visitors
  ipHash       String? // HMAC of the IP address; the raw IP is never stored
  country      String?
  region       String?
  city         String?
  latitude     Float?
  longitude    Float?
  timezone     String? // from the browser
  language     String?
  referrer     String?
  email        String? // attempts only: what was typed in the form
  businessName String?
  error        String? // why an attempt failed
  businessId   String?

  @@index([createdAt])
  @@index([visitorId])
  @@index([stage, createdAt])
}

// A variation of a service the client can choose, e.g. Box braids → Knotless, Bohemian, Jumbo.
// Price and duration fall back to the service's when empty.
model ServiceStyle {
  id          String   @id @default(cuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal? @db.Decimal(10, 2)
  durationMin Int?
  position    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  media       Media[]

  @@index([serviceId])
}

// Uploaded images (service photos, style photos, salon logos), stored as compressed WebP/JPEG/PNG.
// Served from /img/<id>/<slug>.<ext> with long-lived caching, so search engines can index them.
model Media {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       String // "service" | "logo"
  serviceId  String?
  service    Service?      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  styleId    String?
  style      ServiceStyle? @relation(fields: [styleId], references: [id], onDelete: SetNull)
  mime       String
  width      Int
  height     Int
  data       Bytes
  thumb      Bytes? // ~480px wide version for lists and carousels
  alt        String
  position   Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([businessId, kind])
  @@index([serviceId, position])
}

// What happened in a salon that the team should know about (new booking, payment, cancellation…).
// userId null = for owners and managers; set = for one person (e.g. the stylist on a booking).
model Notification {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String // booking | rescheduled | cancelled | payment | deposit | alert | test
  title      String
  body       String
  url        String?
  readBy     String[] @default([]) // user ids that have seen it
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

// A browser or installed app (PWA) that receives push notifications for one person.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  endpoint   String    @unique
  p256dh     String
  auth       String
  device     String? // short description from the user agent, shown in settings
  createdAt  DateTime  @default(now())
  lastOkAt   DateTime?

  @@index([userId])
}

// Sales leads: salons Darling's team reaches out to. Public business contact details only.
model Lead {
  id            String         @id @default(cuid())
  name          String
  type          String? // hair | barber | nails | spa | lashes | braids | mixed
  city          String?
  area          String?
  phone         String?
  whatsapp      String?
  instagram     String?
  tiktok        String?
  facebook      String?
  website       String?
  email         String?
  bookingMethod String?
  fitNote       String?
  sources       String[]       @default([])
  confidence    String?
  status        String         @default("NEW") // NEW | CONTACTED | REPLIED | DEMO | TRIAL | PAYING | NOT_INTERESTED | DO_NOT_CONTACT
  notes         String?
  followUpAt    DateTime?
  lastContactAt DateTime?
  businessId    String? // set when the lead signs up
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  activity      LeadActivity[]

  @@index([status])
  @@index([city])
}

model LeadActivity {
  id     String   @id @default(cuid())
  leadId String
  lead   Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind   String // whatsapp | instagram | email | call | note | status
  text   String
  actor  String
  at     DateTime @default(now())

  @@index([leadId, at])
}

// Reviews of Darling from salons that use it. Only published with the salon's explicit consent
// and the admin's approval; the average shown publicly counts every review.
model Review {
  id         String    @id @default(cuid())
  businessId String    @unique // one review per salon (they can update it)
  userId     String
  rating     Int // 1-5
  body       String
  authorName String
  authorRole String?
  salonName  String
  city       String?
  consent    Boolean   @default(false) // may show name, salon and words on Darling's website
  status     String    @default("PENDING") // PENDING | APPROVED | HIDDEN
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?
}

/// Complaints and feedback a salon's users send to the Laazizi team (emailed to the team inbox, with an automatic reply).
model Complaint {
  id         String    @id @default(cuid())
  number     Int       @unique @default(autoincrement()) // shown as the reference, e.g. C-0007
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  name       String
  email      String
  phone      String?
  category   String
  subject    String
  message    String
  status     String    @default("NEW") // NEW | IN_PROGRESS | RESOLVED
  emailedAt  DateTime? // when the team inbox got it
  repliedAt  DateTime? // when the automatic reply went out
  emailError String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([businessId, createdAt])
  @@index([status, createdAt])
}
